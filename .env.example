# COFA FORWARD — environment variables (copy to .env and fill in; .env is git-ignored)
# No credentials are required to launch the base application in sample mode.

# --- Optional live data providers ---
# Open-Meteo (no key required; free tier). Leave empty to use defaults.
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

# Optional local LLM endpoint for intelligence narrative (disabled by default).
# COFA_LLM_ENDPOINT=http://127.0.0.1:11434/v1
# COFA_LLM_MODEL=llama3
# COFA_LLM_API_KEY=

# Google WeatherNext 3 (allowlist-gated — see docs/DATA_SOURCES.md)
# Once approved, point ADC at a service-account key and set the project.
# WEATHERNEXT_GCP_PROJECT=
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# NVIDIA Earth-2 / FourCastNet / StormCast (hosted NIM needs a paid key)
# NVIDIA_API_KEY=

# NASA Earthdata (for GPM IMERG). Either export the bearer token or let
# earthaccess use ~/.netrc / interactive login.
# EARTHDATA_TOKEN=
# NOTE: IMERG also requires a one-time EULA acceptance at
#   https://urs.earthdata.nasa.gov/approve_app?client_id=e2WVk8Pw6weeLUKZYOxvTQ
